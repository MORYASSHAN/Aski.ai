# ---- Platform infrastructure only ----
# Per-user provider credentials (LiveKit / STT / LLM / Email / Calendar) are
# NEVER stored here. They are brought by each user and kept as encrypted
# Integration documents. See the BYOK architecture spec (Part 4).

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (your own MongoDB)
MONGODB_URI=mongodb://localhost:27017/aski

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" (min 32 chars)
JWT_ACCESS_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption — generate with: openssl rand -hex 32  (64 hex chars = 32-byte key)
# WARNING: rotating this after real integrations exist makes all stored keys undecryptable.
ENCRYPTION_KEY=replace-with-64-hex-char-key-generated-by-openssl-rand-hex-32
